{
  "name": "plainsurvey",
  "version": "0.1.0-rc1",
  "description": "Framework-agnostic survey core, renderer, builder and analytics library.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./builder": {
      "import": "./dist/builder/index.js",
      "require": "./dist/builder/index.cjs"
    },
    "./renderer": {
      "import": "./dist/renderer/index.js",
      "require": "./dist/renderer/index.cjs"
    },
    "./preview": {
      "import": "./dist/preview/index.js",
      "require": "./dist/preview/index.cjs"
    },
    "./analytics": {
      "import": "./dist/analytics/index.js",
      "require": "./dist/analytics/index.cjs"
    },
    "./analysis": {
      "import": "./dist/analysis/index.js",
      "require": "./dist/analysis/index.cjs"
    },
    "./ai": {
      "import": "./dist/ai/index.js",
      "require": "./dist/ai/index.cjs"
    },
    "./styles": {
      "import": "./dist/styles/index.js",
      "require": "./dist/styles/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./styles/plainsurvey.css": "./dist/styles/plainsurvey.css",
    "./styles/themes.css": "./dist/styles/themes.css",
    "./styles/skins.css": "./dist/styles/skins.css",
    "./styles/layouts.css": "./dist/styles/layouts.css",
    "./styles/themes/*.css": "./dist/styles/themes/*.css"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.8.1",
    "@mlc-ai/web-llm": "^0.2.83",
    "jsonrepair": "^3.13.1"
  },
  "devDependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.8.1",
    "@mlc-ai/web-llm": "^0.2.83",
    "jsonrepair": "^3.13.1",
    "happy-dom": "^20.0.11"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "prepublishOnly": "npm run build",
    "test": "node ./scripts/build.mjs && node --test"
  },
  "engines": {
    "node": ">=20"
  }
}
